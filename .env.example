# Copy to .env.local and fill in. Never commit real values.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only
# Random 32-byte hex string. Store its SHA-256 (hex) in private.app_config
# (key = 'submission_key_sha256') for the same environment — see docs/DATABASE_SCHEMA.md.
FORM_SUBMISSION_KEY=
# Random 32-byte hex string used to hash visitor IPs for rate limiting (raw IPs are never stored).
IP_HASH_SALT=
# Email notifications (ADR-008). Leave EMAIL_PROVIDER unset → emails disabled; submissions are
# still stored and flagged notification_error = 'email_disabled' for the admin.
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM="MSLAB <no-reply@your-verified-domain>"
# INQUIRY_NOTIFICATION_TO=
